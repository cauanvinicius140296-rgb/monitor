# ============================================================
# Radar de Preços — variáveis de ambiente (MODELO, sem segredos)
# Copie para .env.local (desenvolvimento) ou configure no painel
# da Vercel / GitHub Actions. NUNCA versione o arquivo .env real.
# ============================================================

# --- Banco de dados (PostgreSQL no Neon) ---
# Use a connection string do Neon com sslmode=require.
# Dica: use o endpoint "pooled" (PgBouncer) para a aplicação na Vercel.
DATABASE_URL=postgresql://USUARIO:SENHA@ep-exemplo.sa-east-1.aws.neon.tech/radar_precos?sslmode=require
# Conexões simultâneas por instância da aplicação (padrão 5). Mantenha baixo na Vercel/Neon.
# DATABASE_POOL_MAX=5

# --- Aplicação ---
# URL pública da aplicação (sem barra final). Ex.: https://radar-precos.vercel.app
APP_URL=http://localhost:3000
# Segredo longo e aleatório para assinar/validar sessões (>= 32 caracteres).
# Gere com: openssl rand -base64 48
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-chars-ou-mais

# --- Administrador (usado apenas pelo script `npm run admin:create`) ---
ADMIN_EMAIL=voce@exemplo.com
# Preferencialmente defina a senha apenas no momento da execução do script.
ADMIN_PASSWORD=

# --- Agendador / cron ---
# Segredo enviado no header "Authorization: Bearer <CRON_SECRET>" pelo agendador.
# Gere com: openssl rand -hex 32  (também cadastre em GitHub Secrets como CRON_SECRET)
CRON_SECRET=

# --- Mercado Livre (API oficial) ---
# Consulta GET /items/{id} em api.mercadolibre.com. Se o token estiver vazio, o adaptador
# consulta sem Authorization. Se a API responder 401/403 (ver docs da API), crie um app em
# https://developers.mercadolivre.com.br e informe o access token aqui. Tokens expiram e
# precisam ser renovados com o refresh token; nunca versione o token.
MERCADO_LIVRE_ACCESS_TOKEN=

# --- Amazon Brasil, Magalu e Fast Shop — NÃO integrados ---
# Hoje o Radar reconhece o link dessas lojas para cadastro, mas NÃO consulta preços
# automaticamente. Antes de qualquer integração, confirme na documentação oficial da loja
# as condições de acesso e as credenciais exigidas. Não há credenciais a preencher agora.
# Ver docs/implantacao.md, seção "Credenciais de APIs".
# AMAZON_PAAPI_ACCESS_KEY=
# AMAZON_PAAPI_SECRET_KEY=
# AMAZON_PAAPI_PARTNER_TAG=
# MAGALU_API_CLIENT_ID=
# MAGALU_API_CLIENT_SECRET=

# --- Dados de demonstração (SOMENTE desenvolvimento/teste) ---
# Só o script `npm run seed:demo` lê esta variável. Dados demo são marcados como
# source='demo', aparecem com [DEMO] no nome e nunca entram na coleta automática.
# Nunca defina em produção.
# RADAR_DEMO_SEED=

# --- Limites de coleta (opcionais; valores padrão no código) ---
# Ordem de precedência: padrão do código < estas variáveis < valores salvos em Configurações.
# COLETA_LOTE_MAXIMO=20
# COLETA_MAX_POR_LOJA=10
# COLETA_INTERVALO_MINIMO_HORAS=6
# COLETA_TIMEOUT_MS=10000
# COLETA_ORCAMENTO_TEMPO_MS=240000
